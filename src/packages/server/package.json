{
  "name": "@ss/rtdb-server",
  "version": "0.1.0",
  "description": "Standalone server form of ss-rtdb (engine + HTTP protocol shell; depends on @ss/rtdb-core)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rtdb-server": "./src/main.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ss/rtdb-core": "^0.1.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\""
  }
}
